<script>
    function change_hud(
        element_clicked: string,
        portofolio: Element,
        button: Element,
    ) {
        button.classList.add("active");
        button.classList.add("unselectable");
        for (const child of portofolio.children) {
            if (!child.classList.contains("hide")) {
                child.classList.add("hide");
            }
        }
        switch (element_clicked) {
            case "Programming":
                portofolio
                    .querySelector(".programming")
                    ?.classList.remove("hide");
                break;
            case "Music":
                portofolio.querySelector(".music")?.classList.remove("hide");
                break;
            case "Pixel art":
                portofolio
                    .querySelector(".pixel_art")
                    ?.classList.remove("hide");
                break;
            case "Misc":
                portofolio.querySelector(".misc")?.classList.remove("hide");
                break;
        }
    }
    const portofolio_div = document.getElementById("portofolio");
    const buttons = document.querySelectorAll("button.child");
    buttons.forEach((button) => {
        if (!portofolio_div) {
            return;
        }
        button.addEventListener("click", () => {
            const text = button.querySelector("h5")?.textContent;
            if (!text) {
                return;
            }

            buttons.forEach((button) => {
                button.classList.remove("active");
                button.classList.remove("unselectable");
            });
            change_hud(text, portofolio_div, button);
        });
        const text = button.querySelector("h5")?.textContent;
        if (!text) {
            return;
        }
        if (text === "Programming") {
            change_hud(text, portofolio_div, button);
            button.classList.add("active");
            button.classList.add("unselectable");
        }
    });
</script>
<style>
    button {
        background-color: transparent;
        border-color: transparent;
        font-family: inherit;
        font-size: inherit;
    }
    .hudcontainer {
        display: flex;
        justify-content: center;
        margin: 2em 2em;
    }
    .hud {
        width: 40em;
        height: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-radius: 14px;
        box-shadow: light-dark(rgb(255, 200, 200), rgb(150, 30, 0)) 0 0 20px;
    }

    .child:hover {
        border-color: light-dark(blue, yellow);
    }
    .child:hover h5,
    .child.active h5 {
        color: light-dark(rgb(0, 0, 180), rgb(220, 190, 110));
        text-shadow: rgb(200, 200, 255) 0 0 14px;
    }

    .child:active {
        border-color: rgb(250, 0, 150);
    }

    .child:active h5 {
        color: rgb(250, 0, 150);
        text-shadow: rgb(200, 100, 180) 0 0 19px;
    }
    .child.active {
        border-color: light-dark(blue, yellow);
        box-shadow: light-dark(rgb(200, 200, 255), rgb(190, 160, 0)) 0 0 20px;
    }

    .child {
        border-width: 2px 1px 2px 1px;
        border-color: rgb(255, 130, 60);
        border-style: solid;
        background-color: var(--bg-2-color);
        text-align: center;
    }

    .child.first {
        border-width: 2px 1px 2px 2px;
        border-top-left-radius: 14px;
        border-bottom-left-radius: 14px;
    }
    .child.last {
        border-width: 2px 2px 2px 1px;
        border-top-right-radius: 14px;
        border-bottom-right-radius: 14px;
    }
    h5 {
        margin: 0.8em 1em 0.8em 1em;
        color: light-dark(rgb(190, 100, 30), rgb(220, 190, 110));
        text-shadow: rgb(200, 200, 180) 0 0 14px;
        font-weight: normal;
        padding: 0;
    }
    @media screen and (max-width: 1000px) {
        h5 {
            font-size: 1em;
        }
    }
    @media screen and (min-width: 1000px) {
        h5 {
            font-size: 1.1em;
        }
    }
    .hide {
        display: none !important;
    }
    .programming {
    }
    @media screen and (max-width: 1200px) {
        .programming_pc {
            display: none;
        }
        .programming_mob {
            display: block;
        }
    }
    @media screen and (min-width: 1200px) {
        .programming_pc {
            display: flex;
            justify-content: center;
        }
        .programming_mob {
            display: none;
        }
    }
    @media screen and (max-width: 1150px) {
        .pixel_art_pc {
            display: none;
        }
        .pixel_art_mob {
            display: block;
        }
    }
    @media screen and (min-width: 1150px) {
        .pixel_art_pc {
            display: block;
        }
        .pixel_art_mob {
            display: none;
        }
    }
    .flexcon {
        display: flex;
        justify-content: space-evenly;
    }
    .music_ {
        display: grid;
        grid-auto-flow: dense;
        justify-items: stretch;
        align-items: stretch;
        justify-content: center;
        align-content: stretch;
    }

    @media screen and (min-width: 800px) {
        .music_ {
            grid-template-columns: auto auto;
        }
        .pc {
            display: grid;
        }
        .mob {
            display: none !important;
        }
    }
    @media screen and (max-width: 800px) {
        .music_ {
            grid-template-columns: auto;
        }
        .pc {
            display: none !important;
        }
        .mob {
            display: grid;
        }
    }
</style>
