---
import BaseLayout from "../layouts/BaseLayout.astro";
import Exhibit1Layout from "../layouts/Exhibit1Layout.astro";
import DrawingLayout from "../layouts/DrawingLayout.astro";
import "../styles/palette.css";
import "../styles/global.css";
import "../styles/exhibit.css";
---

<BaseLayout href="/portofolio">
    <div class="hudcontainer">
        <div class="hud">
            <button class="child first">
                <h5 class="unselectable">Programming</h5>
            </button>
            <button class="child"><h5 class="unselectable">Music</h5></button>
            <button class="child last">
                <h5 class="unselectable">Pixel art</h5>
            </button>
        </div>
    </div>
    <div id="portofolio">
        <div class="programming hide">
            <div class="programming_pc">
                <Exhibit1Layout
                    x_style="background-color: var(--ep-background-color); border-color: var(--ep-border-color); box-shadow: var(--ep-box-shadow);"
                    t_style="color: var(--ep-text-color); text-shadow: var(--ep-text-shadow);"
                    title="- Hyper 2 (COMING SOON) -"
                    href="https://store.steampowered.com/app/3152630/HYPER_2"
                    src="/imgs/sshyper.png"
                    style="width:30em; height:auto;"
                    >A rogue-like sorta-top-down endless tower defense games
                    with arcadey graphics and unique game mechanics. Defend your
                    tower for as long as you can from the invasive aliens! Level
                    up, earn money and new units, and strategically place them
                    in the grid for optimal performance! Let's see how long you
                    last... Coming probably not soon to be honest.</Exhibit1Layout
                >
                <Exhibit1Layout
                    x_style="background-color: var(--ep-background-color); border-color: var(--ep-border-color); box-shadow: var(--ep-box-shadow);"
                    t_style="color: var(--ep-text-color); text-shadow: var(--ep-text-shadow);"
                    title="- Blobby Balls -"
                    href="https://tasty-kiwi.itch.io/blobby-balls"
                    src="/imgs/bb.png"
                    style="width:20em; height:auto;"
                >
                    A 2D pixel-art fast-paced precision puzzle-platformer game
                    that me and 3 other friends made in 10-days for the Godot
                    Wild Jam #83, using, as you can imagine, the Godot game
                    engine. You have a myriad of levels to complete, the goal
                    being to consume all the red balls, which can become quite
                    mind-racking in some levels. Eat your way into solving
                    puzzle and get rewarded with speedrun medals in the process!
                </Exhibit1Layout>
                <Exhibit1Layout
                    x_style="background-color: var(--ep-background-color); border-color: var(--ep-border-color); box-shadow: var(--ep-box-shadow);"
                    t_style="color: var(--ep-text-color); text-shadow: var(--ep-text-shadow);"
                    title="- Hybroid Live -"
                    href="https://hybroid.pewpew.live/hybroid-live/"
                    src="/imgs/hybroid.png"
                    style="width:20em; height:auto;"
                    >A domain-specific programming language, handcrafted for
                    making PewPew Live levels. It's strongly-typed and provides
                    a variety of features that most modern languages have, while
                    also providing special features like repeat statements,
                    better for loops and tick statements. If you don't want to
                    have a headache making PewPew Live levels, this is the go-to
                    language!</Exhibit1Layout
                >
            </div>
            <div class="programming_mob">
                <div class="flexcon">
                    <Exhibit1Layout
                        x_style="background-color: var(--ep-background-color); border-color: var(--ep-border-color); box-shadow: var(--ep-box-shadow);"
                        t_style="color: var(--ep-text-color); text-shadow: var(--ep-text-shadow);"
                        title="- Hyper 2 (COMING SOON) -"
                        href="https://store.steampowered.com/app/3152630/HYPER_2"
                        src="/imgs/sshyper.png"
                        style="width:max(0em, min(88vw, 40em)); height:auto;"
